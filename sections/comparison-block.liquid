{%- comment -%}
  Comparison block (product or collection page) – question boxes, products and table of one model.

  Metafields (both lists of metaobject references):
  - custom.model_group    (list of model_group metaobjects – the tables)
  - custom.model_chooser  (list of model_chooser metaobjects – question boxes, note and products)

  Product page: every row of the comparison guide (custom.comparison_group) is a model – the row
  title, or the row's product title. Each model gets a panel built from the model_group and
  model_chooser whose `model` field matches it. Clicking View in the comparison guide shows that
  model's panel (no page change); when nothing matches, or the match is empty, a not-found message
  is shown instead. Shown first: the current product's model, else the first model with content.
  Collection page: the first model_group, with the model_chooser of the same model.

  model_group fields (table fields, see snippets/comparison-table):
  - model                            (single line text – must match a comparison guide row title, e.g. "Voronoi helmets")
  - title                            (single line text – table heading, the model is added after it, e.g. "Compare all")
  - rows                            (list of comparison_row metaobjects)
  - table_intro                      (rich text – shown above the table)
  - table_footer                     (rich text – shown below the table)
  Table column labels (Model, Shell, Style, Finish, Best for, Price) come from the section settings.

  model_chooser fields:
  - model     (single line text – must match a comparison guide row title, e.g. "Voronoi helmets")
  - heading   (single line text, optional – the model is added after it, e.g. "Comparison: FreeJump")
  - questions (list of comparison_question metaobjects)
  - note      (rich text or multi-line text – e.g. "Not sure? Book a free fitting…")
  - products  (list of product references – theme product cards, 4 per row)

  comparison_question fields:
  - title   (single line text)
  - text    (rich text)
  - options (list of links – shown as pill buttons)

  Panel markup: snippets/comparison-model-panel.
{%- endcomment -%}
{%- liquid
  assign panels = ''
  assign panel_keys = '|'
  assign first_key = ''
  assign current_model_key = ''
  assign has_guide = false

  if product
    assign groups = product.metafields.custom.model_group.value
    assign choosers = product.metafields.custom.model_chooser.value
  elsif collection
    assign groups = collection.metafields.custom.model_group.value
    assign choosers = collection.metafields.custom.model_chooser.value
  endif

  if product
    assign guide_rows = product.metafields.custom.comparison_group.value.rows.value
    if guide_rows.size > 0
      assign has_guide = true
    endif

    # The current product's guide row is the model shown first
    for row in guide_rows
      if row.product.value.id == product.id
        assign row_title = row.product.value.title
        if row.title != blank
          assign row_title = row.title.value
        endif
        assign current_model_key = row_title | strip | handleize
        break
      endif
    endfor

    # One panel per guide model, keyed like the guide's View buttons (snippets/comparison-table)
    for row in guide_rows
      assign row_title = row.product.value.title
      if row.title != blank
        assign row_title = row.title.value
      endif
      assign row_name = row_title | strip | downcase
      assign row_model_key = row_title | strip | handleize
      assign row_token = row_model_key | prepend: '|' | append: '|'
      if row_model_key == blank or panel_keys contains row_token
        continue
      endif

      assign row_group = nil
      for model_group in groups
        assign model_name = model_group.model.value | strip | downcase
        if model_name == row_name
          assign row_group = model_group
          break
        endif
      endfor

      assign row_chooser = nil
      for chooser in choosers
        assign model_name = chooser.model.value | strip | downcase
        if model_name == row_name
          assign row_chooser = chooser
          break
        endif
      endfor

      if row_group == nil and row_chooser == nil
        continue
      endif

      capture panel
        render 'comparison-model-panel', group: row_group, chooser: row_chooser, section: section, current_product: product
      endcapture
      if panel == blank
        continue
      endif

      assign panel_keys = panel_keys | append: row_model_key | append: '|'
      if first_key == blank
        assign first_key = row_model_key
      endif

      capture panel
        echo '<div class="comparison-block__panel" data-model-panel="' | append: row_model_key | append: '" hidden>'
        echo panel
        echo '</div>'
      endcapture
      assign panels = panels | append: panel
    endfor
  elsif collection
    assign row_group = groups | first
    assign row_name = row_group.model.value | strip | downcase
    assign row_chooser = nil
    for chooser in choosers
      assign model_name = chooser.model.value | strip | downcase
      if model_name == row_name
        assign row_chooser = chooser
        break
      endif
    endfor

    if row_name != blank
      capture panels
        render 'comparison-model-panel', group: row_group, chooser: row_chooser, section: section, current_product: nil
      endcapture
      if panels != blank
        assign first_key = row_name | handleize
        assign panels = '<div class="comparison-block__panel" data-model-panel="' | append: first_key | append: '">' | append: panels | append: '</div>'
      endif
    endif
  endif

  # Panel shown first: the current product's model, else the first one with content
  assign initial_key = first_key
  assign current_token = current_model_key | prepend: '|' | append: '|'
  if current_model_key != blank and panel_keys contains current_token
    assign initial_key = current_model_key
  endif
  if product and initial_key != blank
    assign hidden_attr = 'data-model-panel="' | append: initial_key | append: '" hidden'
    assign shown_attr = 'data-model-panel="' | append: initial_key | append: '"'
    assign panels = panels | replace_first: hidden_attr, shown_attr
  endif

  # Product page: also output (hidden) when no model has content yet, so View can show the not-found message
  assign show_section = false
  if panels != blank or has_guide
    assign show_section = true
  endif
-%}


{%- if show_section -%}
  <div id="ComparisonBlock-{{ section.id }}" class="comparison-block {% if section.settings.color_scheme != 'default' %}use-color-scheme use-color-scheme--{{ section.settings.color_scheme }} fully-padded-row--{{ section.settings.height }}{% else %}fully-spaced-row--{{ section.settings.height }}{% endif %}"{% if initial_key == blank %} hidden{% endif %} {%- render 'animation-attrs', attrs: 'data-cc-animate' -%}>
    <div class="container">
      {{ panels }}

      {%- if has_guide -%}
        <div class="comparison-block__empty" data-model-empty hidden>
          <p>{{ section.settings.not_found_text | escape }}</p>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if has_guide -%}
    <script>
      (() => {
        const block = document.getElementById('ComparisonBlock-{{ section.id }}');
        if (!block) return;

        const panels = block.querySelectorAll('[data-model-panel]');
        const empty = block.querySelector('[data-model-empty]');

        const markSelected = (key) => {
          document.querySelectorAll('[data-model-row]').forEach((row) => {
            row.classList.toggle('is-selected', row.dataset.modelRow === key);
          });
        };

        // Shows the model's panel, or the not-found message when it has none
        const showModel = (key) => {
          let found = false;
          panels.forEach((panel) => {
            const match = panel.dataset.modelPanel === key;
            panel.hidden = !match;
            if (match) found = true;
          });
          empty.hidden = found;
          block.hidden = false;
          markSelected(key);
          scrollToBlock();
        };

        // Scrolls to the top of the section (its top spacing included), below a sticky header
        const scrollToBlock = () => {
          const pageHeader = document.getElementById('pageheader');
          const headerSection = pageHeader && (pageHeader.closest('.shopify-section') || pageHeader);
          let headerHeight = 0;
          if (headerSection && ['sticky', 'fixed'].includes(getComputedStyle(headerSection).position)) {
            headerHeight = headerSection.offsetHeight;
          }

          const spacing = parseFloat(getComputedStyle(block).marginTop) || 0;
          const top = block.getBoundingClientRect().top + window.scrollY - spacing - headerHeight;
          window.scrollTo({ top: Math.max(top, 0), behavior: 'smooth' });
        };

        // The current product's label switches back to its own model
        document.querySelectorAll('span[data-model-key]').forEach((label) => {
          label.setAttribute('role', 'button');
          label.tabIndex = 0;
          label.classList.add('is-clickable');
        });

        const onTrigger = (event) => {
          if (!block.isConnected) return;
          const trigger = event.target.closest('[data-model-key]');
          if (!trigger) return;

          if (event.type === 'keydown') {
            // Buttons already turn Enter and Space into a click
            if (trigger.tagName === 'BUTTON' || (event.key !== 'Enter' && event.key !== ' ')) return;
          }

          event.preventDefault();
          showModel(trigger.dataset.modelKey);
        };

        document.addEventListener('click', onTrigger);
        document.addEventListener('keydown', onTrigger);
        markSelected('{{ initial_key }}');
      })();
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Comparison block",
  "class": "section-comparison-block",
  "enabled_on": {
    "templates": ["product", "collection"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Table: metafield custom.model_group (list of model_group metaobjects). Question boxes, note and products: metafield custom.model_chooser (list of model_chooser metaobjects). On product pages, View in the comparison guide shows the model_group and model_chooser whose model field matches that row. The model is added after the headings, or use [name] to place it."
    },
    {
      "type": "header",
      "content": "Comparison table"
    },
    {
      "type": "checkbox",
      "id": "show_table",
      "label": "Show comparison table",
      "default": true
    },
    {
      "type": "text",
      "id": "model_label",
      "label": "Model column label",
      "default": "Model"
    },
    {
      "type": "text",
      "id": "column_1_label",
      "label": "Column 1 label",
      "info": "Leave empty to hide the column",
      "default": "Shell"
    },
    {
      "type": "text",
      "id": "column_2_label",
      "label": "Column 2 label",
      "default": "Style"
    },
    {
      "type": "text",
      "id": "column_3_label",
      "label": "Column 3 label",
      "default": "Finish"
    },
    {
      "type": "text",
      "id": "column_4_label",
      "label": "Column 4 label",
      "default": "Best for"
    },
    {
      "type": "text",
      "id": "price_label",
      "label": "Price column label",
      "default": "Price"
    },
    {
      "type": "header",
      "content": "Question boxes"
    },
    {
      "type": "checkbox",
      "id": "show_questions",
      "label": "Show question boxes",
      "default": true
    },
    {
      "type": "text",
      "id": "questions_heading",
      "label": "Heading",
      "info": "Used when the model_chooser has no heading",
      "default": "Which [name] is right for you?"
    },
    {
      "type": "checkbox",
      "id": "show_products",
      "label": "Show products",
      "info": "Products from the model_chooser (4 per row, 2 on mobile)",
      "default": true
    },
    {
      "type": "header",
      "content": "Not found"
    },
    {
      "type": "text",
      "id": "not_found_text",
      "label": "Message",
      "info": "Shown when the model clicked in the comparison guide has no model_group or model_chooser, or they are empty",
      "default": "No comparison found for this model."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Section height",
      "default": "medium",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ]
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison block"
    }
  ]
}
{% endschema %}
