{%- comment -%}
  Comparison guide (product page).
  Shows only when the product has a metafield custom.comparison_group (metaobject reference).
  Lists every row of that group; the current product's row is highlighted.
{%- endcomment -%}
{%- assign group = product.metafields.custom.comparison_group.value -%}


{%- if group != blank and group.rows.value.size > 0 -%}

  {%- liquid
    assign group_name = group.name.value | default: product.type
    assign guide_heading = section.settings.heading | replace: '[name]', group_name | replace: '[Name]', group_name
  -%}
  <div class="comparison-guide {% if section.settings.color_scheme != 'default' %}use-color-scheme use-color-scheme--{{ section.settings.color_scheme }} fully-padded-row--{{ section.settings.height }}{% else %}fully-spaced-row--{{ section.settings.height }}{% endif %}" {%- render 'animation-attrs', attrs: 'data-cc-animate' -%}>
    <div class="container">
      <div class="comparison-guide__header">
        {%- if section.settings.subheading != blank -%}
          <div class="subheading comparison-guide__subheading">{{ section.settings.subheading | escape }}</div>
        {%- endif -%}
        {%- if guide_heading != blank -%}
          <h2 class="majortitle h1 comparison-guide__heading">{{ guide_heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte comparison-guide__text">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      {% render 'comparison-table', group: group, style: 'guide', section: section, current_product: product %}
    </div>
  </div>
{%- endif -%}

