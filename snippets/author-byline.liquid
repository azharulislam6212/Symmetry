{%- comment -%}
  Author byline: the author name linked to the author's page, optionally with credentials.
  e.g. "Catherine Winter, BHS Stage 4 Coach"

  Link: the Author entry's own webpage (/pages/author/<handle>), else its `page` field.

  Accepts:
  - author: the Author metaobject (optional – without it, the plain name is shown)
  - fallback_name: plain author name (article.author)
  - show_credentials: false to hide the credentials (e.g. on blog listing cards). Default: true
{%- endcomment -%}
{%- liquid
  assign author_name = author.name.value | default: fallback_name
  assign author_url = author.system.url
  if author_url == blank
    assign author_url = author.page.value.url
  endif
  assign author_credentials = author.credentials.value
  if show_credentials == false
    assign author_credentials = blank
  endif
-%}
{%- if author_name != blank -%}
  <span class="author">
    {%- if author_url != blank -%}
      <a href="{{ author_url }}" rel="author">{{ author_name | escape }}</a>
    {%- else -%}
      {{ author_name | escape }}
    {%- endif -%}
    {%- if author_credentials != blank -%}
      <span class="author__credentials">, {{ author_credentials | escape }}</span>
    {%- endif -%}
  </span>
{%- endif -%}
