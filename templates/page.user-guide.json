        "text_FMqGC7": {
          "type": "text",
          "settings": {
            "text": "<p>Whether it’s clipping your air vest lanyard to your saddle correctly or replacing your air canister, we want to make sure it’s done right. Click on the brand of your product for user guides and how-to videos.<br\/><br\/>For information about flying with your CO2 canisters, select the \"Flying with Canisters\" icon.<\/p><p>PLEASE NOTE: Please refer to the manufacturers’ guidance on maintenance to ensure the functionality of your safety equipment.<\/p>",
            "enlarge_text": true
          }
        }
